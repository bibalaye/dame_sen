# --- Serveur de comptes (Supabase) -------------------------------------------
#
# Sans ces deux valeurs, le jeu fonctionne entièrement : la progression reste
# alors conservée dans le navigateur, et la fenêtre « compte » indique que les
# comptes ne sont pas activés.
#
# Où les trouver : Supabase > votre projet > Project Settings > API.
# Ces clés partent dans le navigateur : elles sont publiques par nature. Ce qui
# protège les données, ce sont les règles d'accès définies dans
# supabase/schema.sql, pas le secret de ces clés.
#
# Ne jamais mettre ici la clé « service_role » : elle contourne toutes les
# règles d'accès.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Serveur de parties en ligne ---------------------------------------------
#
# Adresse du serveur socket.io (server.js). En développement, la valeur est
# devinée à partir de l'adresse de la page ; en production, elle est requise.

NEXT_PUBLIC_REALTIME_URL=
